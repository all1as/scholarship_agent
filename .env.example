# Скопировать в .env и заполнить. Файл .env в git не попадает.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
# Необязательно: модель другого семейства для второго разметчика (OpenRouter)
OPENROUTER_API_KEY=
# Модель системы (как в спайке): OpenAI
OPENAI_API_KEY=
# Цена модели, $ за 1M токенов (вход, выход) — сверить со страницей цен провайдера
PRICE_IN=
PRICE_OUT=
# Необязательно: OpenAI-совместимый провайдер (например, https://openrouter.ai/api/v1)
OPENAI_BASE_URL=
